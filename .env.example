VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# server-only, never shipped to the browser (also set on Vercel for /api/pdf)
SUPABASE_SECRET_KEY=sb_secret_...
# optional: where /api/pdf loads the app's /print routes from (defaults to the request host)
# PDF_ORIGIN=https://havarc.vercel.app
# Brevo SMTP (Supabase auth emails) — used only by `npm run config:push`
SMTP_USER=you@example.com
SMTP_PASS=xsmtpsib-...
SMTP_SENDER=verified-sender@example.com
